[Unit]
Description=COGNEX Dashboard — Monitoring API
After=network.target prajnan-agent.service

[Service]
Type=simple
User=anijay2021
WorkingDirectory=/home/anijay2021/cognex-dashboard
EnvironmentFile=-/home/anijay2021/cognex-dashboard/.env
ExecStart=/home/anijay2021/cognex-dashboard/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cognex-dashboard
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
