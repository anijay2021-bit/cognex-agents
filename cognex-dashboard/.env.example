# COGNEX Dashboard credentials — REQUIRED.
# The dashboard fails closed (HTTP 503) until BOTH of these are set.
DASH_USER=changeme
DASH_PASS=change-this-to-a-strong-password

# The service binds to 127.0.0.1 only. Reach it over an SSH tunnel, e.g.:
#   ssh -L 8000:127.0.0.1:8000 anijay2021@<vm-ip>
# then open http://127.0.0.1:8000
